{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/thomaszdxsn/GitHub-Switcher/schemas/tool-definition.schema.json",
  "title": "ToolDefinition",
  "description": "工具静态定义 - 硬编码在 src/lib/config.ts",
  "type": "object",
  "required": ["id", "name", "description", "icon", "urlTemplate", "defaultOrder"],
  "properties": {
    "id": {
      "type": "integer",
      "description": "工具唯一标识符",
      "minimum": 1,
      "maximum": 9,
      "examples": [1, 2, 3]
    },
    "name": {
      "type": "string",
      "description": "工具显示名称（英文）",
      "minLength": 1,
      "maxLength": 30,
      "examples": ["GitHub.dev", "DeepWiki", "CodeWiki"]
    },
    "description": {
      "type": "string",
      "description": "工具简短描述（40-60 字符，英文）",
      "minLength": 40,
      "maxLength": 60,
      "examples": [
        "GitHub's official online code editor for quick edits",
        "AI-powered documentation generator for code repositories"
      ]
    },
    "icon": {
      "type": "string",
      "description": "工具图标（16x16 SVG 字符串或 Data URL）",
      "minLength": 1,
      "examples": [
        "<svg width=\"16\" height=\"16\">...</svg>",
        "data:image/svg+xml;base64,PHN2Zy4uLjwvc3ZnPg=="
      ]
    },
    "urlTemplate": {
      "type": "string",
      "description": "工具 URL 模板（支持 {owner}, {repo} 占位符）",
      "pattern": "^https?://.*\\{owner\\}.*\\{repo\\}.*",
      "examples": [
        "https://github.dev/{owner}/{repo}",
        "https://deepwiki.com/{owner}/{repo}"
      ]
    },
    "defaultOrder": {
      "type": "integer",
      "description": "默认排序位置",
      "minimum": 1,
      "maximum": 9,
      "examples": [1, 2, 3]
    }
  },
  "examples": [
    {
      "id": 1,
      "name": "GitHub.dev",
      "description": "GitHub's official online code editor for quick edits",
      "icon": "<svg width=\"16\" height=\"16\"><path d=\"M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z\"/></svg>",
      "urlTemplate": "https://github.dev/{owner}/{repo}",
      "defaultOrder": 1
    },
    {
      "id": 2,
      "name": "DeepWiki",
      "description": "AI-powered documentation generator for code repositories",
      "icon": "<svg width=\"16\" height=\"16\">...</svg>",
      "urlTemplate": "https://deepwiki.com/{owner}/{repo}",
      "defaultOrder": 2
    }
  ]
}
